<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:p="http://www.springframework.org/schema/p"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">


<!-- INITIAL - INICIO-->
	<bean id="viewResolver" class="org.springframework.web.servlet.view.InternalResourceViewResolver">
		<property name="viewClass" value="org.springframework.web.servlet.view.JstlView"></property>
		<property name="prefix" value="/pages/"></property>
		<property name="suffix" value=".html"></property>
	</bean>
<!-- INITIAL - FIN-->

<!-- JDBC - INICIO -->
	<bean id="dataSource" class="org.springframework.jdbc.datasource.DriverManagerDataSource">
		<property name="driverClassName" value="com.mysql.jdbc.Driver"></property>
		<property name="url" value="jdbc:mysql://169.169.0.21:3306/curso"></property>
		<property name="username" value="curso"></property>
		<property name="password" value="curso"></property>
	</bean>
	
	<bean id="plantilla" class="org.springframework.jdbc.core.JdbcTemplate" p:dataSource-ref="dataSource"></bean>
<!-- JDBC - FIN -->

	<bean id="/login.xhtml" class="com.controladores.PrimerControlador" p:plantilla-ref="plantilla"></bean>
</beans>

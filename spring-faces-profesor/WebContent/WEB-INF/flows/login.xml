<?xml version="1.0" encoding="UTF-8"?>
<flow xmlns="http://www.springframework.org/schema/webflow"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/webflow http://www.springframework.org/schema/webflow/spring-webflow-2.0.xsd" >
 
    
 
    <view-state id="login" model="usuarios">
        <transition on="ok" to="verificausuario"/>
        
    </view-state>
    <view-state id="step2" >
        <transition on="previous" to="login"/>
        <transition on="next" to="confirmation"/>
    </view-state>
     <action-state id="verificausuario">
     <evaluate expression="usuarios.validar()">
     
     </evaluate>
     <transition on="ok" to="step2"/>
     </action-state>
 
    <end-state id="confirmation" view="confirmation.xhtml" />
 
</flow>
<?xml version="1.0"?>
<faces-config version="2.0" xmlns="http://java.sun.com/xml/ns/javaee"
 xmlns:xi="http://www.w3.org/2001/XInclude"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_2_0.xsd">
 
	<application>
		<el-resolver>org.springframework.web.jsf.el.SpringBeanFacesELResolver</el-resolver>
	</application>
 
 	<managed-bean>
 		<managed-bean-name>persona</managed-bean-name>
 		<managed-bean-class>com.beans.Persona</managed-bean-class>
 		<managed-bean-scope>session</managed-bean-scope>
 		<managed-property>
			<property-name>plantilla</property-name>
			<property-class>org.springframework.jdbc.core.JdbcTemplate</property-class>
			<value>#{plantilla}</value>
		</managed-property>
 	</managed-bean>
 	
 	<navigation-rule>
 		<from-view-id>/persona.jsp</from-view-id>
 		<navigation-case>
 			<from-outcome>OK</from-outcome>
 			<to-view-id>/pages/coche.jsf</to-view-id>
 		</navigation-case>
 	</navigation-rule>
 	
 	
 	<managed-bean>
 		<managed-bean-name>poliza</managed-bean-name>
 		<managed-bean-class>com.beans.Poliza</managed-bean-class>
 		<managed-bean-scope>session</managed-bean-scope>
 		<managed-property>
			<property-name>sessionFactory</property-name>
			<value>#{sessionFactory}</value>
		</managed-property>
 	</managed-bean>
 	
 	<!-- 
 	<validator>
 		<validator-id>loginvalidador</validator-id>
 		<validator-class>com.validadores.LoginValidator</validator-class>
 	</validator>
 	-->
 	
 	<navigation-rule>
 		<from-view-id>/login.jsp</from-view-id>
 		<navigation-case>
 			<from-outcome>OK</from-outcome>
 			<to-view-id>/pages/ok.html</to-view-id>
 		</navigation-case>
 	</navigation-rule>
  
 
 <navigation-rule>
 		<from-view-id>/login.jsp</from-view-id>
 		<navigation-case>
 			<from-outcome>KO</from-outcome>
 			<to-view-id>pages/ko.html</to-view-id>
 		</navigation-case>
 	</navigation-rule>
 
 </faces-config>
 
 
 
 
 
 

 
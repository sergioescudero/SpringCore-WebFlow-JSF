<?xml version="1.0" encoding="UTF-8"?>

<faces-config
    xmlns="http://java.sun.com/xml/ns/javaee"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd"
    version="1.2">
    
	<managed-bean>
		<managed-bean-name>login</managed-bean-name>
		<managed-bean-class>domain.Login</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>usuario</property-name>
			<property-class>java.lang.String</property-class>
			<value>Introduce Usuario</value>
		</managed-property>
	</managed-bean>
	<managed-bean>
		<managed-bean-name>persona</managed-bean-name>
		<managed-bean-class>domain.Persona</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>

	</managed-bean>
	<managed-bean>
		<managed-bean-name>hogar</managed-bean-name>
		<managed-bean-class>domain.Hogar</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>

	</managed-bean>
	<managed-bean>
		<managed-bean-name>coche</managed-bean-name>
		<managed-bean-class>domain.Coche</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>

	</managed-bean>
	
		<managed-bean>
		<managed-bean-name>moto</managed-bean-name>
		<managed-bean-class>domain.Moto</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>

	</managed-bean>
	
	
	<validator>
	   <validator-id>mi</validator-id>
	   <validator-class>validadores.Validator</validator-class>
	   
	
	</validator>

	<navigation-rule>
		<from-view-id>/login.jsp</from-view-id>
		<navigation-case>
		    <from-outcome>ok</from-outcome>   
		    <to-view-id>ok</to-view-id>
		</navigation-case>
		<navigation-case>
		    <from-outcome>ko</from-outcome>
		    <to-view-id>ko</to-view-id>
		</navigation-case>	
	</navigation-rule>
	
	<navigation-rule>
		<from-view-id>/persona.jsp</from-view-id>
		<navigation-case>
		    <from-outcome>ok</from-outcome>   
		    <to-view-id>/coche.jsp</to-view-id>
		</navigation-case>
		
	</navigation-rule>
</faces-config>

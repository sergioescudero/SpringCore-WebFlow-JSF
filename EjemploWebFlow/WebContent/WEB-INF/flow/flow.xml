<?xml version="1.0" encoding="UTF-8"?>
<flow xmlns="http://www.springframework.org/schema/webflow"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/webflow
        http://www.springframework.org/schema/webflow/spring-webflow-2.0.xsd">
	
	<view-state id="uno" view="uno">
		<transition on="ok1" to="dos"></transition>
	</view-state>
	<view-state id="dos" view="dos">
		<transition on="ok2" to="tres"></transition>
	</view-state>
	<view-state id="tres" view="tres">
		<transition on="ok3" to="fin"></transition>
	</view-state>



	
	<end-state id="fin" view="fin">
	</end-state>
</flow>
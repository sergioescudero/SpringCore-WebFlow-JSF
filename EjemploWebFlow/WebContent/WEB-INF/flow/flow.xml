<?xml version="1.0" encoding="UTF-8"?>
<flow xmlns="http://www.springframework.org/schema/webflow"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/webflow
        http://www.springframework.org/schema/webflow/spring-webflow-2.0.xsd">
	
	<view-state id="inicio" view="inicio">
		<transition on="ok1" to="intermedio"></transition>
	</view-state>
	<view-state id="intermedio" view="medio">
		<transition on="ok2" to="tercero"></transition>
	</view-state>
	<view-state id="tercero" view="tercero">
		<transition on="ok3" to="fin"></transition>
	</view-state>



	
	<end-state id="fin" view="fin">
	</end-state>
</flow>